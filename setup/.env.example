# Environment for the docker stack (setup/compose.yml), which runs
# sloper-controller. Copy this file to .env and fill it in:
#     cp setup/.env.example setup/.env
#
# Repos are NOT configured here: attach them through the controller (the
# console's "New repo" button, or POST /api/repos) and it starts one container
# per repo with these credentials.

GH_TOKEN=""
GH_USERNAME=""
GH_EMAIL=""


# Controller
# SLOPER_CONTROLLER_TOKEN: required, because the controller binds 0.0.0.0
#   inside the container and refuses to serve an unauthenticated API off
#   loopback. The console sends it as a bearer token on the Repositories page.
#   Generate one with: openssl rand -hex 24
SLOPER_CONTROLLER_TOKEN=""
# SLOPER_CONTROLLER_PORT: host port for the controller API (default 9090).
# SLOPER_CONTROLLER_PORT="9090"
# SLOPER_PORT_RANGE: host ports handed out, one per attached repo (default
#   8080-8180). Each repo's dashboard API is published on one of them.
# SLOPER_PORT_RANGE="8080-8180"
# SLOPER_PUBLISH_ADDR / SLOPER_PUBLIC_HOST: where repo instances are reachable.
#   Keep 127.0.0.1/localhost when the console runs on this machine; set
#   0.0.0.0 and the host's name or IP when it runs elsewhere.
# SLOPER_PUBLISH_ADDR="127.0.0.1"
# SLOPER_PUBLIC_HOST="localhost"
# SLOPER_IMAGE: image repo containers run; the compose build tags it.
# SLOPER_IMAGE="sloper-agent:latest"


# Agent (pi) Configs
# AGENT_MODEL: model pattern (e.g. "claude-sonnet-4:high", "openai/gpt-4o").
#   Supports "provider/id:thinking" shorthand (e.g. "openai/gpt-4o:high").
#   When using provider prefix in model, AGENT_PROVIDER can be empty.
# AGENT_KEY: API key for the provider (passed to pi as --api-key).
#   Also sets provider-specific env vars if needed (e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY).
# AGENT_PROVIDER: provider name (e.g. "anthropic", "openai", "google", "openrouter").
#   Can be empty if provider is specified via model prefix (e.g. "openai/").
# AGENT_API: (reserved) custom API base URL — not yet supported directly.
AGENT_MODEL=""
AGENT_KEY=""
AGENT_API=""
AGENT_PROVIDER=""


# Cloudflare Tunnel (optional) — used only by `docker compose --profile tunnel up`
# CLOUDFLARED_TOKEN: run token of the tunnel that publishes the controller API
#   (Cloudflare Zero Trust -> Networks -> Tunnels). Hostnames stay configured in
#   the Cloudflare dashboard. Leave empty unless you run that profile: compose
#   interpolates it with an empty default, so plain `make docker` never needs it.
#   Started without one the container exits at once (status 255), and
#   `restart: unless-stopped` keeps retrying it, so set it before using the profile.
CLOUDFLARED_TOKEN=""
